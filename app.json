{
  "expo": {
    "name": "UniPool",
    "slug": "UniPool",
    "scheme": "unipool",
    "version": "2.0.11",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#B5D750"
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "18",
      "bundleIdentifier": "com.carpoolitapp"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon2.png",
        "backgroundColor": "#B5D750"
      },
      "splash": {
        "image": "./assets/icon2.png",
        "resizeMode": "contain",
        "backgroundColor": "#B5D750"
      },
      "versionCode": 18,
      "package": "com.carpoolitapp",
      "config": {
        "googleMaps": {
          "apiKey": "${MAPS_API_KEY}"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "updates": {
      "enabled": true,
      "url": "https://unidev.acmvit.in/api/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "useEmbeddedUpdate": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "@react-native-firebase/auth",
        {
          "ios": {
            "captchaOpenUrlFix": false
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/notification.mp3"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "UniPool needs your location to find rides near you, show your pickup point to drivers, and calculate accurate routes."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "UniPool needs calendar access to add your ride schedule and set reminders so you never miss a carpool.",
          "remindersPermission": "UniPool needs reminders access to alert you before your scheduled rides so you're always on time."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B5D750",
          "image": "./assets/splash-screen.png",
          "resizeMode": "cover",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#0F0F12",
            "image": "./assets/splash-screen-dark.png",
            "resizeMode": "cover",
            "imageWidth": 220
          },
          "android": {
            "backgroundColor": "#B5D750",
            "image": "./assets/icon2.png",
            "resizeMode": "contain",
            "imageWidth": 220,
            "dark": {
              "backgroundColor": "#0F0F12",
              "image": "./assets/icon2-dark.png",
              "resizeMode": "contain",
              "imageWidth": 220
            }
          },
          "ios": {
            "backgroundColor": "#B5D750",
            "image": "./assets/splash-screen.png",
            "resizeMode": "cover",
            "dark": {
              "backgroundColor": "#0F0F12",
              "image": "./assets/splash-screen-dark.png",
              "resizeMode": "cover"
            }
          }
        }
      ],
      "expo-sqlite",
      "expo-router",
      "@maplibre/maplibre-react-native"
    ]
  }
}
