{
  "name": "unipool-new-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "EXPO_WEB_BASE_URL=/app NODE_OPTIONS=\"--max-old-space-size=8192\" npx expo export -p web --output-dir dist-web --clear",
    "landing:install": "npm --prefix landing ci",
    "landing:build": "npm --prefix landing run build",
    "landing:stage": "npm --prefix landing run stage:app",
    "build:pages": "npm run web:export && npm run landing:install && npm run landing:build && npm run landing:stage"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/metro-runtime": "~56.0.15",
    "@maplibre/maplibre-react-native": "^11.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "axios": "^1.16.1",
    "date-fns": "^4.3.0",
    "expo": "~56.0.12",
    "expo-apple-authentication": "^56.0.4",
    "expo-build-properties": "~56.0.19",
    "expo-calendar": "^56.0.8",
    "expo-constants": "^56.0.15",
    "expo-device": "^56.0.4",
    "expo-font": "^56.0.5",
    "expo-haptics": "^56.0.3",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.18",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "^56.0.10",
    "expo-sqlite": "~56.0.5",
    "expo-system-ui": "^56.0.5",
    "expo-updates": "~56.0.19",
    "google-auth-library": "^10.6.2",
    "lottie-react-native": "^7.3.8",
    "lottie-web": "^5.13.0",
    "lucide-react-native": "^1.16.0",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^4.4.1",
    "prop-types": "^15.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-map-gl": "^7.1.9",
    "react-native": "^0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-maps": "^1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "playwright-core": "^1.60.0",
    "typescript": "^6.0.3"
  },
  "private": true
}
