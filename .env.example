# UniPool Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files to version control

# Google Maps API Keys
GOOGLE_MAPS_API_KEY_IOS=your_ios_api_key_here
GOOGLE_MAPS_API_KEY_ANDROID=your_android_api_key_here

# Backend API URL
API_BASE_URL=https://unibackend.acmvit.in

# Firebase Configuration (if needed separately from google-services files)
# These are typically handled by the google-services.json and GoogleService-Info.plist files
